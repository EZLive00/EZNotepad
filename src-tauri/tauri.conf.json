{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "简单记事本",
  "version": "1.0.0",
  "identifier": "com.simple.notepad",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "简单记事本",
        "width": 1280,
        "height": 820,
        "minWidth": 620,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false,
        "visible": true,
        "theme": null,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu-sandbox"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob: https: file:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown",
        "description": "Markdown 文档",
        "mimeType": "text/markdown",
        "role": "Editor"
      },
      {
        "ext": ["txt", "log"],
        "name": "Text",
        "description": "纯文本",
        "mimeType": "text/plain",
        "role": "Editor"
      },
      {
        "ext": ["json"],
        "name": "JSON",
        "description": "JSON 文件",
        "mimeType": "application/json",
        "role": "Editor"
      },
      {
        "ext": ["csv"],
        "name": "CSV",
        "description": "逗号分隔表格",
        "mimeType": "text/csv",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}